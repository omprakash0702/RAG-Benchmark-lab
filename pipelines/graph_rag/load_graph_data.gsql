//                WHEN FIND(e.entity_name, "Corporation") >= 0 THEN "Corporation"
//                WHEN FIND(e.entity_name, "Partnership")  >= 0 THEN "Partnership"
//                WHEN FIND(e.entity_name, "Sole")         >= 0 THEN "SoleProprietorship"
//                ELSE "Unknown"
